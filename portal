F.nuevaCuenta=async f=>{const e=f.elements,type=e.type.value,cur=e.cur.value;const prod=S.products.find(p=>p.product_type===type&&p.currency_code===cur);if(!prod){toast('No existe un producto activo para ese tipo y moneda.',1);return}const rate=Math.min(3,Math.max(0,parseFloat(e.rate.value)||0))/100;const {data,error}=await SB.from('accounts').insert({owner_profile_id:S.cid,product_id:prod.id,account_type:type,currency_code:cur,monthly_rate:rate,status:'active'}).select('id').single();if(error){toast(error.message,1);return}const amt=Math.round((parseFloat(e.amt.value)||0)*100)/100;if(amt>0){const r=await SB.from('ledger_entries').insert({account_id:data.id,entry_type:type==='loan'?'loan_disbursement':'capital_contribution',amount:type==='loan'?-amt:amt,currency_code:cur,description:'Monto inicial',created_by:S.me.id,idempotency_key:crypto.randomUUID()});if(r.error)toast(r.error.message,1)}toast('Cuenta creada.');A.verCliente(S.cid)};
F.movimiento=async f=>{const e=f.elements,x=S.ac.find(a=>a.account_id===e.acc.value),t=e.type.value,amt=Math.round(parseFloat(e.amt.value)*100)/100;if(!(amt>0)){toast('Escribe un monto mayor a cero.',1);return}if(x.status!=='active'){toast('La cuenta debe estar activa para registrar movimientos.',1);return}const val=t==='capital_adjustment'?(e.dir.value==='-'?-amt:amt):MOV[t][1]*amt,bal=Number(x.balance);if(x.account_type!=='loan'&&val<0&&bal+val<0){toast('Saldo insuficiente. Disponible: '+fm(bal,x.currency_code),1);return}if(t==='loan_repayment'&&amt>-bal+0.004){toast('El pago supera la deuda pendiente de '+fm(Math.max(0,-bal),x.currency_code),1);return}const {error}=await SB.from('ledger_entries').insert({account_id:x.account_id,entry_type:t,amount:val,currency_code:x.currency_code,description:e.desc.value.trim()||null,created_by:S.me.id,idempotency_key:crypto.randomUUID()});if(error){toast(error.message,1);return}toast('Movimiento guardado.');A.verCliente(S.cid)};
A.bienes=async st=>{$('#main').innerHTML=`<div class='chips'>${[['pendiente','Pendientes'],['aprobada','Aprobadas'],['rechazada','Rechazadas'],['publicadas','Publicadas en el sitio']].map(([k,l])=>`<button data-a='bienes' data-id='${k}' class='${k===st?'on':''}'>${l}</button>`).join('')}</div><div id='bl'><p class='muted'>Cargando\u2026</p></div>`;if(st==='publicadas'){const {data,error}=await SB.from('properties_public').select('*').order('created_at',{ascending:false});if(error){$('#bl').innerHTML=`<p class='err'>${esc(error.message)}</p>`;return}$('#bl').innerHTML=data.map(p=>`<div class='prop'><div><b>${esc(p.titulo)}</b><small>${esc(p.ubicacion)}</small><small>${p.publicada?'Visible en el sitio':'Oculta'}</small></div><div class='amt'>${p.precio!=null?fm(p.precio,p.moneda):''}</div><div class='row'><button class='ghost' data-a='publicar' data-id='${p.id}' data-v='${p.publicada?0:1}'>${p.publicada?'Ocultar del sitio':'Publicar en el sitio'}</button></div></div>`).join('')||`<p class='muted'>Todav\u00eda no hay propiedades publicadas.</p>`;return}const {data,error}=await SB.from('property_submissions').select('*').eq('status',st).order('created_at',{ascending:false});if(error){$('#bl').innerHTML=`<p class='err'>${esc(error.message)}</p>`;return}$('#bl').innerHTML=data.map(p=>`<div class='prop'><div><b>${esc(p.titulo)}</b><small>${esc(p.ubicacion)}</small><p>${esc(p.descripcion)}</p><small>Contacto: ${esc(p.nombre_contacto)}, ${esc(p.telefono_contacto)}${p.email_contacto?', '+esc(p.email_contacto):''}</small>${p.rejection_reason?`<small>Motivo del rechazo: ${esc(p.rejection_reason)}</small>`:''}</div><div class='amt'>${p.precio!=null?fm(p.precio,p.moneda):''}</div>${st==='pendiente'?`<div class='row'><button class='primary' data-a='decidir' data-id='${p.id}' data-v='1'>Aprobar y publicar</button><button class='ghost danger' data-a='decidir' data-id='${p.id}' data-v='0'>Rechazar</button></div>`:''}</div>`).join('')||`<p class='muted'>No hay propuestas en esta lista.</p>`};
A.decidir=async(id,v)=>{let r;if(v==='1'){r=await SB.rpc('fye_aprobar_propuesta',{p_submission_id:id})}else{const m=prompt('Motivo del rechazo:');if(!m)return;r=await SB.rpc('fye_rechazar_propuesta',{p_submission_id:id,p_motivo:m})}toast(r.error?r.error.message:(v==='1'?'Propiedad aprobada y publicada.':'Propuesta rechazada.'),!!r.error);if(!r.error)A.bienes('pendiente')};
A.publicar=async(id,v)=>{const {error}=await SB.from('properties_public').update({publicada:v==='1'}).eq('id',id);toast(error?error.message:'Listo.',!!error);A.bienes('publicadas')};
A.mis=async()=>{const {data:a}=await SB.from('fye_account_balances').select('*').eq('owner_profile_id',S.me.id).order('opened_on');const ac=a||[],ids=ac.map(x=>x.account_id);const nm=Object.fromEntries(ac.map(x=>[x.account_id,TIPO[x.account_type]+' en '+x.currency_code]));let m=[];if(ids.length){const r=await SB.from('ledger_entries').select('*').in('account_id',ids).order('created_at',{ascending:false}).limit(30);m=r.data||[]}$('#main').innerHTML=`<h2>Hola, ${esc(S.me.full_name||'')}</h2>${S.me.is_active?'':`<p class='note'>Tu cuenta est\u00e1 pendiente de aprobaci\u00f3n por la administraci\u00f3n.</p>`}<div class='accs'>${ac.map(x=>accCard(x,0)).join('')||`<p class='muted'>Todav\u00eda no tienes cuentas registradas.</p>`}</div><h3>\u00daltimos movimientos</h3>${movTable(m,nm)}`};
async function boot(){const {data:{session}}=await SB.auth.getSession();if(!session){loginView();return}const {data:me}=await SB.from('profiles').select('*').eq('id',session.user.id).maybeSingle();if(!me){$('#app').innerHTML=`<section class='login'><h1>Tu perfil todav\u00eda no est\u00e1 creado.</h1><p>Comun\u00edcate con la administraci\u00f3n de F &amp; E Inversiones.</p><button class='ghost' data-a='salir'>Salir</button></section>`;return}S.me=me;S.staff=['admin','secretaria'].includes(me.role);shell();if(S.staff){const {data}=await SB.from('financial_products').select('*').eq('active',true);S.products=data||[];A.go('clientes')}else A.mis()}
document.addEventListener('click',e=>{const t=e.target.closest('[data-a]');if(t&&A[t.dataset.a])A[t.dataset.a](t.dataset.id,t.dataset.v)});
document.addEventListener('submit',e=>{const f=e.target;if(f.dataset.f&&F[f.dataset.f]){e.preventDefault();F[f.dataset.f](f)}});
document.addEventListener('change',e=>{const k=e.target.dataset.cc;if(k&&C[k])C[k](e.target)});
document.addEventListener('input',e=>{const k=e.target.dataset.ci;if(k&&C[k])C[k](e.target)});
SB.auth.onAuthStateChange(ev=>{if(ev==='SIGNED_OUT')loginView()});
boot();
</script></body></html>
