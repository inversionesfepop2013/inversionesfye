A.verCliente=async id=>{S.cid=id;$('#main').innerHTML=`<p class='muted'>Cargando\u2026</p>`;const [p,a]=await Promise.all([SB.from('profiles').select('*').eq('id',id).single(),SB.from('fye_account_balances').select('*').eq('owner_profile_id',id).order('opened_on')]);if(p.error||a.error){toast((p.error||a.error).message,1);return A.clientes()}const c=p.data;S.ac=a.data;$('#main').innerHTML=`<button class='ghost' data-a='clientes'>Volver a clientes</button><h2>${esc(c.full_name||'Sin nombre')}</h2><small>${esc(c.email)}, rol ${esc(c.role)}${c.document_number?', documento '+esc(c.document_number):''} ${badge(c)}</small><p><button class='ghost' data-a='activar' data-v='${c.is_active?0:1}'>${c.is_active?'Desactivar cliente':'Activar cliente'}</button></p><h3>Cuentas</h3><div class='accs'>${S.ac.map(x=>accCard(x,1)).join('')||`<p class='muted'>Este cliente a\u00fan no tiene cuentas. Crea la primera aqu\u00ed abajo.</p>`}</div><div class='grid2'><form class='card' data-f='nuevaCuenta'><h3 style='margin-top:0'>Nueva cuenta</h3><label>Tipo<select name='type'><option value='certificate'>Certificado</option><option value='investment'>Inversi\u00f3n</option><option value='savings'>Ahorro</option><option value='loan'>Deuda / pr\u00e9stamo</option></select></label><label>Moneda<select name='cur'><option>DOP</option><option>USD</option></select></label><label>Tasa mensual (%, m\u00e1ximo 3)<input name='rate' type='number' step='0.01' min='0' max='3' value='0'></label><label>Monto inicial (opcional)<input name='amt' type='number' step='0.01' min='0'></label><button class='primary'>Crear cuenta</button></form>${S.ac.length?`<form id='fm' class='card' data-f='movimiento'><h3 style='margin-top:0'>Registrar movimiento</h3><label>Cuenta<select name='acc' data-cc='acc'>${S.ac.map(x=>`<option value='${x.account_id}'>${TIPO[x.account_type]} en ${x.currency_code}</option>`).join('')}</select></label><label>Tipo de movimiento<select name='type' data-cc='tipo'></select></label><label id='dirw' hidden>Ajuste<select name='dir'><option value='+'>Aumentar</option><option value='-'>Disminuir</option></select></label><label>Monto<input name='amt' type='number' step='0.01' min='0.01' required></label><label>Nota (opcional)<input name='desc' maxlength='200'></label><button class='primary'>Guardar movimiento</button></form>`:''}</div><h3>Movimientos de la cuenta</h3><div id='hist'></div>`;if(S.ac.length)opts()};
A.activar=async(_,v)=>{const on=v==='1';const u=on?{is_active:true,approval_status:'activo',approved_by:S.me.id,approved_at:new Date().toISOString()}:{is_active:false};const {error}=await SB.from('profiles').update(u).eq('id',S.cid);if(!error&&on)await SB.from('registration_requests').update({status:'aprobada',decided_by:S.me.id,decided_at:new Date().toISOString()}).eq('profile_id',S.cid).eq('status','pendiente');toast(error?error.message:(on?'Cliente activado.':'Cliente desactivado.'),!!error);if(!error)A.verCliente(S.cid)};
