function loginView(m){m=m||'in';$('#app').innerHTML=`<section class='login'><div class='brand'><b>F &amp; E</b><span>INVERSIONES</span></div><h1>Tu futuro financiero en un solo lugar.</h1><div class='chips'><button data-a='tab' data-id='in' class='${m==='in'?'on':''}'>Entrar</button><button data-a='tab' data-id='up' class='${m==='up'?'on':''}'>Crear cuenta</button></div>${m==='in'?`<form data-f='login'><label>Correo<input name='email' type='email' required autocomplete='username'></label><label>Contrase\u00f1a<input name='pw' type='password' required autocomplete='current-password'></label><button class='primary'>Entrar</button><p id='lerr' class='err'></p></form>`:`<form data-f='registro'><label>Nombre completo<input name='nombre' required autocomplete='name'></label><label>Tipo de documento<select name='dtype'><option value='cedula'>C\u00e9dula dominicana</option><option value='passport'>Pasaporte (extranjero)</option></select></label><label>N\u00famero de documento<input name='doc' required maxlength='20' autocomplete='off'></label><label>Correo<input name='email' type='email' required autocomplete='email'></label><label>Contrase\u00f1a (m\u00ednimo 8 caracteres)<input name='pw' type='password' required minlength='8' autocomplete='new-password'></label><label class='chk'><input type='checkbox' name='ok' required>Acepto el Contrato de Apertura y declaro que los fondos provienen de actividades l\u00edcitas, conforme a la Ley de Lavado de Activos.</label><button class='primary'>Crear cuenta</button><p id='lerr' class='err'></p></form>`}<p><a href='/'>Volver al sitio</a></p></section>`}
