size:13px;color:var(--mut);margin-bottom:10px}label input,label select{margin-top:4px}label.chk{display:flex;gap:8px;align-items:flex-start}label.chk input{width:auto;margin-top:3px}button{font:inherit;cursor:pointer}.primary{background:var(--brand);color:#fff;border:0;border-radius:7px;padding:10px 16px;font-weight:600}.ghost{background:#fff;border:1px solid var(--line);border-radius:7px;padding:8px 12px;color:var(--ink)}.danger{color:var(--bad);border-color:var(--bad)}header .ghost{background:none;color:#fff;border-color:rgba(255,255,255,.4)}:focus-visible{outline:2px solid var(--brass);outline-offset:2px}.scroll{overflow-x:auto;background:#fff;border:1px solid var(--line);border-radius:10px}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--line);vertical-align:top}th{font-size:13px;color:var(--mut);font-weight:500}tbody tr:last-child td{border:0}tbody tr[data-a]{cursor:pointer}tbody tr[data-a]:hover{background:#f0f5f3}.r{text-align:right}th.r{text-align:right}.b{font-style:normal;font-size:12px;padding:2px 9px;border-radius:99px}.ok{background:#dcefe5;color:var(--ok)}.wait{background:#f6ead0;color:#7a5712}.accs{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}.amt{font:700 22px Spectral,Georgia,serif;margin:4px 0 8px}.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:18px}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}.chips button{border:1px solid var(--line);background:#fff;border-radius:99px;padding:7px 14px}.chips .on{background:var(--brand);color:#fff;border-color:var(--brand)}.prop{display:grid;grid-template-columns:1fr auto;gap:8px 16px;margin-bottom:10px}.prop p{margin:6px 0}.row{display:flex;gap:8px;grid-column:1/-1}.login{max-width:420px;margin:6vh auto;padding:0 20px}.login .brand b{font-size:40px;color:var(--brand)}.login .brand span{color:var(--brass)}.login h1{font:700 26px Spectral,Georgia,serif;margin:18px 0}.login a{color:var(--brand)}.err{color:var(--bad)}.note{background:#f6ead0;padding:10px 14px;border-radius:8px}#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 18px;border-radius:8px;opacity:0;pointer-events:none;max-width:90vw}#toast.show{opacity:1}#toast.bad{background:var(--bad)}@media(max-width:600px){.prop{grid-template-columns:1fr}}</style></head><body><div id='app'></div><div id='toast'></div><script src='https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js'></script><script>
