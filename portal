A.go=v=>{document.querySelectorAll('#nav button').forEach(b=>b.classList.toggle('on',b.dataset.id===v));v==='clientes'?A.clientes():A.bienes('pendiente')};
A.clientes=async()=>{$('#main').innerHTML=`<p class='muted'>Cargando clientes\u2026</p>`;const [p,b]=await Promise.all([SB.from('profiles').select('id,email,full_name,role,is_active,approval_status').not('role','in','(admin,secretaria)').order('created_at',{ascending:false}),SB.from('fye_account_balances').select('*')]);if(p.error||b.error){$('#main').innerHTML=`<p class='err'>No se pudieron cargar los datos: ${esc((p.error||b.error).message)}</p>`;return}S.pr=p.data;S.bal=b.data;$('#main').innerHTML=`<div class='stats'><div><span>Ahorros</span>${lines(sumBy(null,['savings']))}</div><div><span>Certificados e inversiones</span>${lines(sumBy(null,['certificate','investment']))}</div><div><span>Deuda pendiente</span>${lines(sumBy(null,['loan']),1)}</div></div><div class='bar'><input id='q' data-ci='tabla' placeholder='Buscar por nombre o correo'></div><div class='scroll'><table><thead><tr><th>Cliente</th><th>Estado</th><th>Ahorro</th><th>Certificado</th><th>Deuda</th></tr></thead><tbody id='tb'></tbody></table></div>`;C.tabla()};
